# 복사해서 .env 로 쓰고, 실제 값은 절대 커밋하지 마세요 (.env 는 .gitignore 처리됨)
JOBHUNT_PASSWORD=change-me-long-random      # 대시보드/API 로그인 (필수: production)
JOBHUNT_USER=admin
SARAMIN_ACCESS_KEY=                          # 사람인 Open API 키
SARAMIN_DAILY_LIMIT=20                       # 하루 최대 호출 횟수
TELEGRAM_BOT_TOKEN=                          # BotFather 발급
TELEGRAM_CHAT_ID=                            # 정기 알림 받을 채팅 ID
